{
  "name": "Pulse Expo Development",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [
    8081
  ],
  "portsAttributes": {
    "8081": {
      "label": "Expo Metro",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },
  "postCreateCommand": "cd frontend && npm ci && npm install --no-save --package-lock=false @expo/ngrok",
  "customizations": {
    "vscode": {
      "extensions": [
        "expo.vscode-expo-tools"
      ]
    }
  }
}
